# Telegram API
API_ID=12345678
API_HASH=your_api_hash_here
PHONE_NUMBER=+201234567890

# Telegram bot
BOT_TOKEN=123456789:your_bot_token_here
BOT_CHAT_ID=123456789
BOT_CHANNEL_ID=
BOT_CHANNEL_CATEGORY_ID=data_analysis
TARGET_CHANNEL_IDS=-1001335768304,-1002142292720,-1001994689105

# Main LLM provider credentials
GEMINI_API_KEYS=key1,key2
GROQ_API_KEY=your_groq_api_key_here

# Provider/model configuration overrides (baseline lives in config/project.json)
# LLM_PROVIDERS is deployment *order*: providers are tried in this order.
LLM_PROVIDERS=gemini,groq
GEMINI_MODELS=gemini-3.5-flash
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Notification Guard
NOTIFICATION_GUARD_ENABLED=false
GROQ_NOTIFICATION_GUARD_API_KEY=your_groq_guard_api_key_here
GROQ_NOTIFICATION_GUARD_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_NOTIFICATION_GUARD_MAX_RETRIES=2
NOTIFICATION_GUARD_PROVIDERS=groq

# FreeHub
FREEHUB_USER_ID=your_user_id
# SECURITY (audit finding P1-5): this default endpoint is plain HTTP,
# not HTTPS -- traffic to it is unauthenticated and unencrypted, so it
# can be tampered with, injected into, or observed on the network
# path. Replace it with an HTTPS endpoint as soon as the upstream
# supports one. Until then, the app logs a startup warning
# (see app.runtime_config) and any project data returned by this
# endpoint should be treated as coming from an untrusted network
# boundary.
FREEHUB_BASE_URL=http://ec2-51-21-119-160.eu-north-1.compute.amazonaws.com/v1/users
FREEHUB_SOURCES=kafiil,freelancer,mostaql,nafezly
FREEHUB_POLL_INTERVAL=60
FREEHUB_PAGE_SIZE=30
FREEHUB_MAX_BACKFILL_PAGES=10

# URL Shortener (internal service used to unify project URLs before they
# are ever saved to the DB). FAILURE_MODE controls what happens when the
# shortener request itself fails (timeout / 5xx / malformed response) --
# it does NOT apply to DUPLICATE_STATUS, which is always treated as a
# stop/skip regardless of FAILURE_MODE. See app/url_shortener.py.
URL_SHORTENER_DOMAIN=
URL_SHORTENER_ENDPOINT=
URL_SHORTENER_FAILURE_MODE=fail_open
URL_SHORTENER_DUPLICATE_STATUS=409

# Runtime / infrastructure
DATABASE_BACKEND=sqlite
DATABASE_FILE_PATH=loki_freelance_bot.db
STATE_BACKEND=json
STATE_FILE_PATH=database/state.json
NOTIFICATION_SINKS=telegram
NOTIFICATION_TRANSPORT=telegram-bot
USER_COMMAND_SURFACE=telegram
JOB_SOURCES=freehub
ENABLED_WORKERS=telegram,freehub,classification_retry,notification_retry,user_notifications
HTTP_TIMEOUT_SECONDS=30
STATE_TIMEOUT_SECONDS=30
DATABASE_TIMEOUT_SECONDS=60
DELIVERY_CONCURRENCY=10
USER_BOT_BATCH_SIZE=20
USER_BOT_MAX_ATTEMPTS=5
USER_BOT_POLL_INTERVAL=1
NOTIFICATION_RETRY_INTERVAL=300
NOTIFICATION_BACKOFF_BASE_SECONDS=5
NOTIFICATION_BACKOFF_CAP_SECONDS=300
TELEGRAM_MAX_RECOVERY_MESSAGES=2000
TELEGRAM_MESSAGE_LIMIT=4096
MESSAGE_SAFETY_MARGIN=96
MAX_DESCRIPTION_LENGTH=3000
MAX_REASON_LENGTH=1200
COMPACT_ARBITRATION_MAX_TEXT_CHARS=3500
TELEGRAM_RECOVERY_RETRY_BASE_SECONDS=5
TELEGRAM_RECOVERY_RETRY_CAP_SECONDS=300
