# ============================================================
# Telegram API
# ============================================================

# Get these from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here
PHONE_NUMBER=+201234567890


# ============================================================
# Telegram Bot
# ============================================================

BOT_TOKEN=123456789:your_bot_token_here
BOT_CHAT_ID=123456789

# Optional public/channel notification destination.
# Leave empty if not used.
BOT_CHANNEL_ID=-1001234567890


# ============================================================
# Google Gemini
# ============================================================

# Multiple API keys separated by commas.
# Keys are tried in order; transient failures are retried
# before moving to the next key.
GEMINI_API_KEYS=key1,key2


# ============================================================
# Groq Fallback
# ============================================================

# Used when the Gemini provider cannot complete the review.
# Groq models are rotated automatically by the application.
GROQ_API_KEY=your_groq_api_key_here


# ============================================================
# Telegram Job Sources
# ============================================================

# Comma-separated Telegram channel IDs to monitor.
TARGET_CHANNEL_IDS=-1001335768304,-1002142292720,-1001994689105


# ============================================================
# FreeHub
# ============================================================

FREEHUB_USER_ID=your_user_id
# Use the HTTPS API endpoint when your FreeHub backend supports TLS.
# The application retains the legacy HTTP endpoint as the default
# for backward compatibility.
FREEHUB_BASE_URL=http://ec2-51-21-119-160.eu-north-1.compute.amazonaws.com/v1/users
FREEHUB_POLL_INTERVAL=60
FREEHUB_PAGE_SIZE=30


# ============================================================
# Notification Guard
# ============================================================

# Optional safety layer for jobs accepted directly by the
# deterministic classifier.
#
# When enabled, direct-accept jobs receive an independent
# Groq-based notification safety review before delivery.
#
# LLM-reviewed jobs bypass the Notification Guard because
# they have already received an LLM review.
NOTIFICATION_GUARD_ENABLED=false

# Dedicated Groq API key for the Notification Guard.
# Leave empty when the guard is disabled.
GROQ_NOTIFICATION_GUARD_API_KEY=your_groq_guard_api_key_here

# Maximum retry attempts per guard model.
GROQ_NOTIFICATION_GUARD_MAX_RETRIES=2

# Notification Guard models are defined in application code
# and rotated automatically. They are intentionally NOT
# configured through environment variables.
