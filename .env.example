# Telegram API (Telethon channel ingestion only -- this node has no
# python-telegram-bot dependency; the user-facing bot, subscription
# management, and notification delivery all live in a separate Node.js service now.)
API_ID=12345678
API_HASH=your_api_hash_here
PHONE_NUMBER=+201234567890
TARGET_CHANNEL_IDS=-1001335768304,-1002142292720,-1001994689105

# Main LLM provider credentials
GEMINI_API_KEYS=key1,key2
GROQ_API_KEY=your_groq_api_key_here

# Provider/model configuration overrides (baseline lives in config/project.json)
# LLM_PROVIDERS is deployment *order*: providers are tried in this order.
LLM_PROVIDERS=gemini,groq
GEMINI_MODELS=gemini-3.5-flash
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Notification Guard
NOTIFICATION_GUARD_ENABLED=false
GROQ_NOTIFICATION_GUARD_API_KEY=your_groq_guard_api_key_here
GROQ_NOTIFICATION_GUARD_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_NOTIFICATION_GUARD_MAX_RETRIES=2
NOTIFICATION_GUARD_PROVIDERS=groq

# FreeHub
FREEHUB_USER_ID=your_user_id
# SECURITY (audit finding P1-5): this default endpoint is plain HTTP,
# not HTTPS -- traffic to it is unauthenticated and unencrypted, so it
# can be tampered with, injected into, or observed on the network
# path. Replace it with an HTTPS endpoint as soon as the upstream
# supports one. Until then, the app logs a startup warning
# (see app.runtime_config) and any project data returned by this
# endpoint should be treated as coming from an untrusted network
# boundary.
FREEHUB_BASE_URL=http://ec2-51-21-119-160.eu-north-1.compute.amazonaws.com/v1/users
FREEHUB_SOURCES=kafiil,freelancer,mostaql,nafezly
FREEHUB_POLL_INTERVAL=60
FREEHUB_PAGE_SIZE=30
FREEHUB_MAX_BACKFILL_PAGES=10

# URL Shortener (internal service used to unify project URLs before they
# are ever saved to the DB). The shortener is an idempotent upsert keyed
# by jobId. FAILURE_MODE controls what happens when the shortener
# request itself fails (timeout / non-2xx / malformed response): fail_open
# keeps the original URL, fail_closed retries the job on the source's
# next poll. See app/url_shortener.py.
URL_SHORTENER_DOMAIN=
URL_SHORTENER_ENDPOINT=
URL_SHORTENER_FAILURE_MODE=fail_open

# Runtime / infrastructure
#
# Persistence is Postgres now (app.adapters.repositories.postgres).
# Schema migrations (migrations/postgres/*.sql) run automatically on
# every startup, so a fresh database is ready without manual steps.
# The runner can also be invoked manually ahead of time with:
# DATABASE_URL=... python scripts/migrate_postgres.py
#
# POSTGRES_USER/PASSWORD/DB are read by docker-compose.yml's `postgres`
# service; docker-compose.yml also overrides DATABASE_URL for the `loki`
# container to point at that service (host `postgres`) using these same
# values, so keep them in sync with DATABASE_URL below if you change
# either. DATABASE_URL as written here (host `localhost`) is what
# `scripts/migrate_postgres.py` and any host-side tooling use, and is
# also what a `python run.py` invoked directly on the host (outside
# docker-compose) will connect to.
POSTGRES_USER=loki
POSTGRES_PASSWORD=loki
POSTGRES_DB=loki
DATABASE_URL=postgresql://loki:loki@localhost:5432/loki

# Required: this node publishes guard-approved jobs here (XADD, full job
# row as fields) for a separate notification/delivery service to
# consume. See app.adapters.streams.redis_publisher.
#
# Redis is hosted on the OTHER node -- this one must reach it over the
# same Tailscale network that Postgres/SSH use, NOT via localhost.
# Point this at that node's reachable address/password:
#   REDIS_URL=redis://:password@redis-node-tailscale-ip:6379/0
# (any reachable host/IP from this node works; the value is passed
# straight through to the client, so TLS/unix-socket/ACL forms are all
# supported). If you run Redis locally for development ONLY, then:
REDIS_URL=redis://localhost:6379/0
JOB_STREAM_NAME=jobs:notify

STATE_BACKEND=json
STATE_FILE_PATH=database/state.json
JOB_SOURCES=freehub
ENABLED_WORKERS=telegram,freehub,classification_retry,notification_retry
HTTP_TIMEOUT_SECONDS=30
STATE_TIMEOUT_SECONDS=30
DATABASE_TIMEOUT_SECONDS=60
NOTIFICATION_RETRY_INTERVAL=300
NOTIFICATION_BACKOFF_BASE_SECONDS=5
NOTIFICATION_BACKOFF_CAP_SECONDS=300
TELEGRAM_MAX_RECOVERY_MESSAGES=2000
TELEGRAM_MESSAGE_LIMIT=4096
MESSAGE_SAFETY_MARGIN=96
MAX_DESCRIPTION_LENGTH=3000
MAX_REASON_LENGTH=1200
COMPACT_ARBITRATION_MAX_TEXT_CHARS=3500
TELEGRAM_RECOVERY_RETRY_BASE_SECONDS=5
TELEGRAM_RECOVERY_RETRY_CAP_SECONDS=300
