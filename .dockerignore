.git
.gitignore
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.github/

# Test / development-only artifacts -- never needed by the runtime image.
# (scripts/ is CI/dev tooling -- ci_smoke_test.py, test.sh -- except
# scripts/migrate_postgres.py, which the Postgres repository imports at
# startup. It is negated below so the Dockerfile can COPY it into the
# image while the rest of scripts/ stays out of the build context.)
tests/
scripts/*
!scripts/migrate_postgres.py
opencode.json

# Development documentation and licensing text. Not required at runtime
# (run_guarded.py, app/, config/ and requirements.txt are what the image
# actually needs).
*.md
LICENSE

# Secrets — never baked into the image. Mount .env at runtime instead.
.env
.env.*

# Runtime data (persisted via volumes / bind mounts)
sessions/
logs/
database/
*.session
*.db
*.sqlite
*.sqlite3
*.xlsx
*.log

# Keep the build context minimal
Dockerfile
.dockerignore
docker-compose.yml
